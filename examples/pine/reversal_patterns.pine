//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Reversal Patterns — détection automatique de figures de retournement.
//
// Fonctionne sur n'importe quel instrument (or, forex, actions, indices) sans
// réglage particulier : toutes les tolérances sont exprimées en multiples d'ATR
// et jamais en points ou en pips. « Deux sommets au même niveau » a donc le même
// sens sur XAUUSD à 2 600 $ que sur EURUSD à 1,08.
//
// Figures détectées :
//   • Double Bottom / Double Top          (3 pivots)
//   • Inverted Head & Shoulders / H&S     (5 pivots)
//
// Le signal est émis à la CASSURE de la neckline, comme sur les schémas
// classiques — pas à la formation de la figure. Entry / SL / TP sont projetés
// selon la méthode du « measured move » : la hauteur de la figure reportée
// depuis la neckline.
//
// Une figure reconnue est « armée » puis attend sa cassure, mais pas
// indéfiniment : elle est abandonnée si le prix franchit son point extrême
// (la figure est détruite) ou si rien ne se passe pendant maxWait bougies.
// Sans ces garde-fous, un double bottom vieux de trois cents bougies se
// déclencherait au premier retour du prix sur son ancienne neckline.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Reversal Patterns — Auto", "Reversals", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ═══ Réglages ════════════════════════════════════════════════════════════════
gD = "Détection"
pivLen  = input.int(5, "Longueur de pivot", minval = 2, maxval = 50, group = gD,
     tooltip = "Nombre de bougies de chaque côté d'un sommet ou d'un creux pour le valider. " +
               "Plus grand = moins de signaux, mais plus fiables. 5 convient en 5 min, 3 en H1.")
tolMult = input.float(0.5, "Tolérance sommets/creux (× ATR)", minval = 0.05, step = 0.05, group = gD,
     tooltip = "Écart maximal admis entre deux sommets (ou deux creux) pour les considérer " +
               "au même niveau. En ATR, donc valable sur tous les instruments.")
atrLen  = input.int(14, "Longueur ATR", minval = 1, group = gD)
slBuf   = input.float(0.25, "Marge du stop (× ATR)", minval = 0.0, step = 0.05, group = gD,
     tooltip = "Distance ajoutée au-delà du point extrême pour placer le stop.")
maxWait = input.int(100, "Expiration d'une figure armée (bougies)", minval = 5, group = gD,
     tooltip = "Une figure dont la neckline n'a toujours pas été cassée après ce nombre de " +
               "bougies est abandonnée. Évite qu'un signal se déclenche des semaines plus tard, " +
               "dans un contexte de marché qui n'a plus rien à voir.")

gP = "Figures"
useDouble = input.bool(true, "Double Top / Double Bottom", group = gP)
useHS     = input.bool(true, "Head & Shoulders / inversé",  group = gP)

gV = "Affichage"
showLevels = input.bool(true, "Tracer Entry / SL / TP", group = gV)
showPivots = input.bool(false, "Marquer les pivots détectés", group = gV)
projLen    = input.int(30, "Longueur des projections (bougies)", minval = 5, group = gV)
colBull    = input.color(#26a69a, "Haussier", group = gV)
colBear    = input.color(#ef5350, "Baissier", group = gV)

// ═══ Collecte des pivots ═════════════════════════════════════════════════════
atrV = ta.atr(atrLen)
tol  = atrV * tolMult

var array<float> pPrice = array.new_float()
var array<int>   pBar   = array.new_int()
var array<bool>  pIsHi  = array.new_bool()

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

// Un pivot confirmé sur la bougie courante s'est produit pivLen bougies plus tôt.
if not na(ph)
    array.push(pPrice, ph)
    array.push(pBar,   bar_index - pivLen)
    array.push(pIsHi,  true)
    if showPivots
        label.new(bar_index - pivLen, ph, "H", style = label.style_label_down,
             color = color.new(colBear, 60), textcolor = color.white, size = size.tiny)

if not na(pl)
    array.push(pPrice, pl)
    array.push(pBar,   bar_index - pivLen)
    array.push(pIsHi,  false)
    if showPivots
        label.new(bar_index - pivLen, pl, "L", style = label.style_label_up,
             color = color.new(colBull, 60), textcolor = color.white, size = size.tiny)

// On ne garde qu'une fenêtre glissante : les figures visées tiennent en 5 pivots.
while array.size(pPrice) > 12
    array.shift(pPrice)
    array.shift(pBar)
    array.shift(pIsHi)

newPivot = not na(ph) or not na(pl)

// Accès « depuis la fin » : 0 = pivot le plus récent, 1 = le précédent, etc.
gPx(int i) => array.get(pPrice, array.size(pPrice) - 1 - i)
gBr(int i) => array.get(pBar,   array.size(pBar)   - 1 - i)
gHi(int i) => array.get(pIsHi,  array.size(pIsHi)  - 1 - i)

// ═══ Armement des figures ════════════════════════════════════════════════════
// Une figure est « armée » dès que sa forme est reconnue, puis confirmée plus
// tard par la cassure de la neckline. Les tests de cassure (ta.crossover /
// ta.crossunder) doivent être évalués à CHAQUE bougie pour garder un état
// correct — ils sont donc placés hors des blocs conditionnels.

// xxInval : niveau dont le franchissement détruit la figure (le prix est passé
//           du mauvais côté du point extrême, il n'y a plus de retournement à
//           attendre). xxArm : bougie d'armement, pour l'expiration.
var bool  dbOn    = false
var float dbNeck  = na
var float dbStop  = na
var float dbTgt   = na
var int   dbFrom  = na
var float dbInval = na
var int   dbArm   = na

var bool  dtOn    = false
var float dtNeck  = na
var float dtStop  = na
var float dtTgt   = na
var int   dtFrom  = na
var float dtInval = na
var int   dtArm   = na

var bool  ihOn    = false
var float ihNeck  = na
var float ihStop  = na
var float ihTgt   = na
var int   ihFrom  = na
var float ihInval = na
var int   ihArm   = na

var bool  hsOn    = false
var float hsNeck  = na
var float hsStop  = na
var float hsTgt   = na
var int   hsFrom  = na
var float hsInval = na
var int   hsArm   = na

// ── Double Bottom : creux, sommet, creux ─────────────────────────────────────
if useDouble and newPivot and array.size(pPrice) >= 3
    if not gHi(2) and gHi(1) and not gHi(0)
        lo2 = gPx(2)
        nk  = gPx(1)
        lo0 = gPx(0)
        // Les deux creux au même niveau, un sommet franc entre les deux, et le
        // prix encore SOUS la neckline — sinon la cassure a déjà eu lieu et
        // armer maintenant produirait un signal immédiat et faux.
        if math.abs(lo2 - lo0) <= tol and nk - math.max(lo2, lo0) > tol and close < nk
            base    = math.min(lo2, lo0)
            dbOn    := true
            dbNeck  := nk
            dbStop  := base - atrV * slBuf
            dbTgt   := nk + (nk - base)
            dbFrom  := gBr(2)
            dbInval := base
            dbArm   := bar_index

// ── Double Top : sommet, creux, sommet ───────────────────────────────────────
if useDouble and newPivot and array.size(pPrice) >= 3
    if gHi(2) and not gHi(1) and gHi(0)
        hi2 = gPx(2)
        nk  = gPx(1)
        hi0 = gPx(0)
        if math.abs(hi2 - hi0) <= tol and math.min(hi2, hi0) - nk > tol and close > nk
            peak    = math.max(hi2, hi0)
            dtOn    := true
            dtNeck  := nk
            dtStop  := peak + atrV * slBuf
            dtTgt   := nk - (peak - nk)
            dtFrom  := gBr(2)
            dtInval := peak
            dtArm   := bar_index

// ── Inverted Head & Shoulders : creux, sommet, creux(tête), sommet, creux ────
if useHS and newPivot and array.size(pPrice) >= 5
    if not gHi(4) and gHi(3) and not gHi(2) and gHi(1) and not gHi(0)
        ls = gPx(4)
        t1 = gPx(3)
        hd = gPx(2)
        t2 = gPx(1)
        rs = gPx(0)
        // Tête nettement plus basse que les épaules, épaules à peu près au même niveau.
        nkI = math.avg(t1, t2)
        if math.min(ls, rs) - hd > tol and math.abs(ls - rs) <= tol and close < nkI
            ihOn    := true
            ihNeck  := nkI
            ihStop  := hd - atrV * slBuf
            ihTgt   := nkI + (nkI - hd)
            ihFrom  := gBr(4)
            ihInval := hd
            ihArm   := bar_index

// ── Head & Shoulders : sommet, creux, sommet(tête), creux, sommet ────────────
if useHS and newPivot and array.size(pPrice) >= 5
    if gHi(4) and not gHi(3) and gHi(2) and not gHi(1) and gHi(0)
        ls = gPx(4)
        t1 = gPx(3)
        hd = gPx(2)
        t2 = gPx(1)
        rs = gPx(0)
        nkH = math.avg(t1, t2)
        if hd - math.max(ls, rs) > tol and math.abs(ls - rs) <= tol and close > nkH
            hsOn    := true
            hsNeck  := nkH
            hsStop  := hd + atrV * slBuf
            hsTgt   := nkH - (hd - nkH)
            hsFrom  := gBr(4)
            hsInval := hd
            hsArm   := bar_index

// ═══ Garde-fous : expiration et invalidation ═════════════════════════════════
// Une figure armée n'attend pas indéfiniment. Elle est abandonnée si le prix
// franchit son point extrême — la figure est alors détruite, il n'y a plus de
// retournement à espérer — ou si la neckline n'a pas cédé après maxWait bougies.
if dbOn and (low  < dbInval or bar_index - dbArm > maxWait)
    dbOn := false
if dtOn and (high > dtInval or bar_index - dtArm > maxWait)
    dtOn := false
if ihOn and (low  < ihInval or bar_index - ihArm > maxWait)
    ihOn := false
if hsOn and (high > hsInval or bar_index - hsArm > maxWait)
    hsOn := false

// ═══ Confirmation : cassure de la neckline ═══════════════════════════════════
// Les appels ta.crossover / ta.crossunder sont évalués sur CHAQUE bougie, sans
// condition, pour que leur état interne reste juste. La cassure doit survenir
// strictement après la bougie d'armement.
dbBreak = dbOn and bar_index > dbArm and ta.crossover(close,  dbNeck)
dtBreak = dtOn and bar_index > dtArm and ta.crossunder(close, dtNeck)
ihBreak = ihOn and bar_index > ihArm and ta.crossover(close,  ihNeck)
hsBreak = hsOn and bar_index > hsArm and ta.crossunder(close, hsNeck)

// ═══ Tracé ═══════════════════════════════════════════════════════════════════
draw(string name, int fromBar, float neck, float stopLvl, float tgt, color c, bool up) =>
    line.new(fromBar, neck, bar_index, neck, color = c, style = line.style_dashed, width = 2)
    label.new(bar_index, up ? low : high, name,
         style     = up ? label.style_label_up : label.style_label_down,
         color     = c, textcolor = color.white, size = size.small)
    if showLevels
        line.new(bar_index, neck,    bar_index + projLen, neck,    color = color.gray, style = line.style_dotted)
        line.new(bar_index, stopLvl, bar_index + projLen, stopLvl, color = colBear,    style = line.style_dotted)
        line.new(bar_index, tgt,     bar_index + projLen, tgt,     color = colBull,    style = line.style_dotted)
        label.new(bar_index + projLen, neck,    "ENTRY", style = label.style_none, textcolor = color.gray, size = size.tiny)
        label.new(bar_index + projLen, stopLvl, "SL",    style = label.style_none, textcolor = colBear,    size = size.tiny)
        label.new(bar_index + projLen, tgt,     "TP",    style = label.style_none, textcolor = colBull,    size = size.tiny)

if dbBreak
    draw("Double Bottom", dbFrom, dbNeck, dbStop, dbTgt, colBull, true)
    dbOn := false

if dtBreak
    draw("Double Top", dtFrom, dtNeck, dtStop, dtTgt, colBear, false)
    dtOn := false

if ihBreak
    draw("Inverted H&S", ihFrom, ihNeck, ihStop, ihTgt, colBull, true)
    ihOn := false

if hsBreak
    draw("Head & Shoulders", hsFrom, hsNeck, hsStop, hsTgt, colBear, false)
    hsOn := false

// ═══ Alertes ═════════════════════════════════════════════════════════════════
alertcondition(dbBreak, "Double Bottom",    "Double Bottom confirmé — neckline cassée")
alertcondition(dtBreak, "Double Top",       "Double Top confirmé — neckline cassée")
alertcondition(ihBreak, "Inverted H&S",     "Inverted Head & Shoulders confirmé — neckline cassée")
alertcondition(hsBreak, "Head & Shoulders", "Head & Shoulders confirmé — neckline cassée")
alertcondition(dbBreak or dtBreak or ihBreak or hsBreak, "Toute figure",
     "Figure de retournement confirmée sur {{ticker}} {{interval}}")

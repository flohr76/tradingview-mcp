//@version=6
// SUPPLY & DEMAND ZONES [Claude] - base d'apres "The Ultimate Supply and Demand Trading Guide" (B. Kenny)
// Zone = BASE (2-6 bougies calmes) + IMPULSION (gros corps) qui en sort.
//   Impulsion haussiere -> DEMANDE (RCR/DCR) : bas de meche -> haut de corps de la base
//   Impulsion baissiere -> OFFRE   (RCD/DCD) : haut de meche -> bas de corps de la base
// Score 1-3 : Temps (base longue) + Force (impulsion forte) + Fraicheur (0 retest).
// Zone supprimee si cloture au-dela du cote oppose, ou trop de retests (absorption).
// Signal BUY/SELL : engulfing ou pin bar DANS une zone. Stop hors zone, TP avant la zone opposee.
// Les seuils (ATR, nb bougies) ne sont pas dans le livre : a regler. Conseille : Daily / H4.
indicator("Supply & Demand Zones [Claude]", "S&D Zones", overlay = true, max_boxes_count = 200)

atrLen      = input.int(14, "Longueur ATR", minval = 1, group = "Detection")
minBase     = input.int(2, "Base : bougies min", minval = 1, group = "Detection")
maxBase     = input.int(6, "Base : bougies max", minval = 1, group = "Detection")
baseBodyMax = input.float(0.6, "Base : corps max (x ATR)", minval = 0.1, step = 0.1, group = "Detection")
baseRngMax  = input.float(1.2, "Base : range max (x ATR)", minval = 0.1, step = 0.1, group = "Detection")
impMult     = input.float(1.5, "Impulsion : corps min (x ATR)", minval = 0.5, step = 0.1, group = "Detection")
priorLen    = input.int(5, "Jambe precedente (bougies)", minval = 1, group = "Detection")
timeBars    = input.int(3, "Temps : base >= N bougies", minval = 1, group = "Score")
strongMult  = input.float(2.5, "Force : impulsion >= X ATR", minval = 1.0, step = 0.1, group = "Score")
minScore    = input.int(1, "Score minimum affiche", minval = 1, maxval = 3, group = "Score")
maxRetests  = input.int(3, "Retests max", minval = 0, group = "Vie des zones")
maxZones    = input.int(8, "Zones max par cote", minval = 1, maxval = 50, group = "Vie des zones")
onlyFresh   = input.bool(false, "Signaux sur zones fraiches seulement", group = "Signaux")
pinRatio    = input.float(2.0, "Pin bar : meche >= X corps", minval = 1.0, step = 0.5, group = "Signaux")
demandCol   = input.color(color.new(#26a69a, 80), "Couleur demande", group = "Style")
supplyCol   = input.color(color.new(#ef5350, 80), "Couleur offre", group = "Style")

var array<box>    zBox   = array.new<box>()
var array<bool>   zDem   = array.new<bool>()
var array<float>  zTop   = array.new<float>()
var array<float>  zBot   = array.new<float>()
var array<int>    zRet   = array.new<int>()
var array<bool>   zIn    = array.new<bool>()
var array<int>    zLen   = array.new<int>()
var array<bool>   zStr   = array.new<bool>()
var array<string> zKind  = array.new<string>()

atrV = ta.atr(atrLen)
body = math.abs(close - open)

zScore(int i) =>
    (zLen.get(i) >= timeBars ? 1 : 0) + (zStr.get(i) ? 1 : 0) + (zRet.get(i) == 0 ? 1 : 0)

zText(int i) =>
    int s = zScore(i)
    (zDem.get(i) ? "D " : "S ") + zKind.get(i) + " " + (s >= 3 ? "***" : s == 2 ? "**" : "*") + (zRet.get(i) > 0 ? " r" + str.tostring(zRet.get(i)) : "")

zRemove(int i) =>
    box.delete(zBox.get(i))
    zBox.remove(i)
    zDem.remove(i)
    zTop.remove(i)
    zBot.remove(i)
    zRet.remove(i)
    zIn.remove(i)
    zLen.remove(i)
    zStr.remove(i)
    zKind.remove(i)

bullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
lowWick = math.min(open, close) - low
upWick = high - math.max(open, close)
bullPin = lowWick >= pinRatio * math.max(body, syminfo.mintick) and close > (high + low) / 2
bearPin = upWick >= pinRatio * math.max(body, syminfo.mintick) and close < (high + low) / 2

bool longSig = false
bool shortSig = false

// 1) Mise a jour des zones existantes (avant creation : l'impulsion n'est pas un retest)
for i = zBox.size() - 1 to 0
    bool dem = zDem.get(i)
    bool touch = low <= zTop.get(i) and high >= zBot.get(i)
    if touch and not zIn.get(i)
        zRet.set(i, zRet.get(i) + 1)
    zIn.set(i, touch)
    bool broken = dem ? close < zBot.get(i) : close > zTop.get(i)
    if broken or zRet.get(i) > maxRetests
        zRemove(i)
    else
        box.set_right(zBox.get(i), bar_index)
        box.set_text(zBox.get(i), zText(i))
        if touch and (not onlyFresh or zRet.get(i) <= 1)
            if dem and (bullEngulf or bullPin)
                longSig := true
            if not dem and (bearEngulf or bearPin)
                shortSig := true

// 2) Detection : bougies de base juste avant la bougie courante (= impulsion)
int k = 0
float bHigh = na
float bLow = na
float bBodyHi = na
float bBodyLo = na
for j = 1 to maxBase
    bool calm = math.abs(close[j] - open[j]) <= baseBodyMax * atrV[j] and high[j] - low[j] <= baseRngMax * atrV[j]
    if not calm
        break
    k += 1
    bHigh := na(bHigh) ? high[j] : math.max(bHigh, high[j])
    bLow := na(bLow) ? low[j] : math.min(bLow, low[j])
    bBodyHi := na(bBodyHi) ? math.max(open[j], close[j]) : math.max(bBodyHi, math.max(open[j], close[j]))
    bBodyLo := na(bBodyLo) ? math.min(open[j], close[j]) : math.min(bBodyLo, math.min(open[j], close[j]))

atrPrev = nz(atrV[1], atrV)
newDemand = k >= minBase and close > open and body >= impMult * atrPrev and close > bHigh
newSupply = k >= minBase and close < open and body >= impMult * atrPrev and close < bLow

if newDemand or newSupply
    bool isD = newDemand
    float top = isD ? bBodyHi : bHigh
    float bot = isD ? bLow : bBodyLo
    float prior = nz(close[k + 1] - close[k + 1 + priorLen], 0.0)
    string kind = isD ? (prior < 0 ? "DCR" : "RCR") : (prior > 0 ? "RCD" : "DCD")
    bool strong = body >= strongMult * atrPrev
    int score = (k >= timeBars ? 1 : 0) + (strong ? 1 : 0) + 1
    bool overlap = false
    int sideCount = 0
    int oldest = -1
    for i = 0 to zBox.size() - 1
        if zDem.get(i) == isD
            sideCount += 1
            if oldest < 0
                oldest := i
            if top >= zBot.get(i) and bot <= zTop.get(i)
                overlap := true
    if score >= minScore and not overlap
        if sideCount >= maxZones
            zRemove(oldest)
        color bg = isD ? demandCol : supplyCol
        color bd = isD ? color.new(#26a69a, 30) : color.new(#ef5350, 30)
        box b = box.new(bar_index - k, top, bar_index, bot, border_color = bd, bgcolor = bg, text_size = size.small, text_color = isD ? #26a69a : #ef5350, text_halign = text.align_right)
        zBox.push(b)
        zDem.push(isD)
        zTop.push(top)
        zBot.push(bot)
        zRet.push(0)
        zIn.push(false)
        zLen.push(k)
        zStr.push(strong)
        zKind.push(kind)
        box.set_text(b, zText(zBox.size() - 1))

plotshape(longSig, "Confirmation achat", shape.triangleup, location.belowbar, color = #26a69a, size = size.small, text = "BUY")
plotshape(shortSig, "Confirmation vente", shape.triangledown, location.abovebar, color = #ef5350, size = size.small, text = "SELL")
plot(na, "S&D", display = display.none)
alertcondition(longSig, "Confirmation dans zone de demande", "Confirmation haussiere dans une zone de demande")
alertcondition(shortSig, "Confirmation dans zone d'offre", "Confirmation baissiere dans une zone d'offre")
